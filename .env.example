# Read https://www.minecraft.net/eula before changing to TRUE.
EULA=FALSE

# Image release and Mojang BDS release are independent.
BEDROCK_IMAGE=itzg/minecraft-bedrock-server:latest
# LATEST fetches the newest stable BDS on EVERY container start, including backup restart.
# Pin the exact BDS version from logs before production/migration.
BEDROCK_VERSION=LATEST
TZ=Asia/Jakarta

SERVER_NAME=Bedrock Bersama
LEVEL_NAME=world
GAMEMODE=survival
DIFFICULTY=normal
MAX_PLAYERS=10
VIEW_DISTANCE=16
TICK_DISTANCE=4

# Windows LAN IPv4 (ipconfig), not the WSL/container IP; VPS: public IPv4.
# Must be an IPv4 literal, not a hostname. Replace this sample.
ADVERTISED_IP=192.168.1.10
BIND_IP=0.0.0.0
SERVER_PORT=19132
# At least one UDP port per player. Keep enough spare ports for reconnects.
UDP_PORT_RANGE=19140-19155

# Local default permits authenticated players. Production forces allowlist on.
ALLOW_LIST=false
# Exact Xbox gamertags, comma separated. Required in production.
ALLOW_LIST_USERS=

# raknet = direct IP join (UDP SERVER_PORT). nethernet = needs extra UDP range; unverified for direct IP.
TRANSPORT=raknet
